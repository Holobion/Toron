RUST_LOG=info

# PowerSync Service Settings
POWERSYNC_PORT=8080
JWKS_URI=http://backend:3000/.well-known/jwks.json

# Frontend (Dioxus Web / Nginx) Settings
FRONTEND_PORT=8000
