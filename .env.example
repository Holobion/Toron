# ==============================================================================
# Toron Environment Configuration
# ==============================================================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=toron
POSTGRES_PORT=5432

# Backend (Axum) Settings
